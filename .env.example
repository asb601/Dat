# --- auth (all three required in production) -------------------------------
# scrypt hash of the admin password — generate with:  npm run hash-password -- "your password"
ADMIN_PASSWORD_HASH=
# random signing secret for session cookies — generate with:  openssl rand -hex 32
SESSION_SECRET=
# unguessable invite token (16+ chars) — generate with:  openssl rand -hex 24
# her link becomes:  https://<your-site>/i/<GUEST_TOKEN>
GUEST_TOKEN=

# --- persistence (required in production) ----------------------------------
# Upstash Redis REST credentials (Vercel marketplace "Upstash for Redis" sets
# these automatically). Local dev without them falls back to .data/state.json.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Legacy Vercel KV names also accepted: KV_REST_API_URL / KV_REST_API_TOKEN
